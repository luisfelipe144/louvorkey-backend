# Cloudinary: usado para uploads de músicas, stems, metrônomo e pitch shift.
CLOUDINARY_CLOUD_NAME="seu_cloud_name"
CLOUDINARY_API_KEY="sua_api_key"
CLOUDINARY_API_SECRET="seu_api_secret"

# Replicate: usado para separar as faixas com Demucs.
REPLICATE_API_TOKEN="seu_token_replicate"

# Opcional: escolha o modelo/formato de separação.
DEMUCS_MODEL="htdemucs_ft"
DEMUCS_OUTPUT_FORMAT="wav"

# Opcional: instâncias Cobalt para baixar áudio do YouTube, separadas por vírgula.
COBALT_API_URL="https://dwnld.nichind.dev,https://api.cobalt.tools,https://cobalt-backend.canine.tools"

# Opcional no frontend local. Em produção, o app usa a URL do Render como padrão.
VITE_API_URL="https://louvorkey-backend.onrender.com"
